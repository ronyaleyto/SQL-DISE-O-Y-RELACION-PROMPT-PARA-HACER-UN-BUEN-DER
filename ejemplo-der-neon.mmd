---
config:
  theme: base
  look: neo
  layout: dagre
  fontFamily: "Segoe UI, Arial, sans-serif"
  themeVariables:
    darkMode: true
    primaryTextColor: "#e2e8f0"
    lineColor: "#a8bad7"
  er:
    fontSize: 12
    entityPadding: 8
    nodeSpacing: 38
    rankSpacing: 55
  themeCSS: |
    .violeta { --neon: #b692ff; --vidrio: #282240; }
    .cian { --neon: #52dcff; --vidrio: #173049; }
    .rosa { --neon: #ff78c8; --vidrio: #39263e; }
    .menta { --neon: #51f5b1; --vidrio: #19363b; }
    .node .outer-path { filter: drop-shadow(0 0 3px var(--neon)) drop-shadow(0 0 7px var(--neon)); }
    .node .outer-path path[stroke="none"] { fill: var(--vidrio) !important; }
    .node .outer-path path[fill="none"] { stroke: var(--neon) !important; stroke-width: 2px; }
    .node .row-rect-odd path[stroke="none"] { fill: var(--vidrio) !important; fill-opacity: .9; }
    .node .row-rect-even path[stroke="none"] { fill: #13203b !important; fill-opacity: .9; }
    .node .row-rect-odd path[fill="none"],
    .node .row-rect-even path[fill="none"] { stroke: #ffffff26 !important; }
    .node .divider { opacity: .25; }
    .node .name .nodeLabel p,
    .node .attribute-keys .nodeLabel p { color: var(--neon) !important; font-weight: 700; }
    .node .name foreignObject { overflow: visible; }
    .relationshipLine { stroke-width: 2px !important; }
    .edgeLabel .labelBkg { background-color: #152338 !important; color: #e2e8f0 !important; }
    .node .outer-path path { d: path("M-126 -114 H126 Q138 -114 138 -102 V102 Q138 114 126 114 H-126 Q-138 114 -138 102 V-102 Q-138 -114 -126 -114 Z"); }
    .node .row-rect-odd path, .node .row-rect-even path { fill: none !important; stroke: none !important; }
    .relationshipLine { stroke-dasharray: 5 4 !important; stroke-linecap: round; }
    .node[id*="-entity-Campus-"] { transform: translate(158px, 134px); }
    .node[id*="-entity-Edificios-"] { transform: translate(526px, 134px); }
    .node[id*="-entity-Aulas-"] { transform: translate(894px, 134px); }
    .node[id*="-entity-Carreras-"] { transform: translate(158px, 399px); }
    .node[id*="-entity-Planes-"] { transform: translate(526px, 399px); }
    .node[id*="-entity-Cursos-"] { transform: translate(894px, 399px); }
    .node[id*="-entity-Estudiantes-"] { transform: translate(158px, 664px); }
    .node[id*="-entity-Matriculas-"] { transform: translate(526px, 664px); }
    .node[id*="-entity-Secciones-"] { transform: translate(894px, 664px); }
    .node[id*="-entity-Becas-"] { transform: translate(158px, 929px); }
    .node[id*="-entity-Pagos-"] { transform: translate(526px, 929px); }
    .node[id*="-entity-Evaluaciones-"] { transform: translate(894px, 929px); }
    .node[id*="-entity-Convocatorias-"] { transform: translate(158px, 1194px); }
    .node[id*="-entity-Recibos-"] { transform: translate(526px, 1194px); }
    .node[id*="-entity-Resultados-"] { transform: translate(894px, 1194px); }
    .relationshipLine[data-id$="_0"] { d: path("M 296 134 L 388 134"); }
    g.edgeLabel:has(.label[data-id$="_0"]) { transform: translate(342px, 119px); }
    .relationshipLine[data-id$="_1"] { d: path("M 664 134 L 756 134"); }
    g.edgeLabel:has(.label[data-id$="_1"]) { transform: translate(710px, 119px); }
    .relationshipLine[data-id$="_2"] { d: path("M 158 248 L 158 285"); }
    g.edgeLabel:has(.label[data-id$="_2"]) { transform: translate(209px, 266.5px); }
    .relationshipLine[data-id$="_3"] { d: path("M 296 399 L 388 399"); }
    g.edgeLabel:has(.label[data-id$="_3"]) { transform: translate(342px, 384px); }
    .relationshipLine[data-id$="_4"] { d: path("M 664 399 L 756 399"); }
    g.edgeLabel:has(.label[data-id$="_4"]) { transform: translate(710px, 384px); }
    .relationshipLine[data-id$="_5"] { d: path("M 158 513 L 158 550"); }
    g.edgeLabel:has(.label[data-id$="_5"]) { transform: translate(209px, 531.5px); }
    .relationshipLine[data-id$="_6"] { d: path("M 296 664 L 388 664"); }
    g.edgeLabel:has(.label[data-id$="_6"]) { transform: translate(342px, 649px); }
    .relationshipLine[data-id$="_7"] { d: path("M 894 513 L 894 550"); }
    g.edgeLabel:has(.label[data-id$="_7"]) { transform: translate(945px, 531.5px); }
    .relationshipLine[data-id$="_8"] { d: path("M 756 664 L 664 664"); }
    g.edgeLabel:has(.label[data-id$="_8"]) { transform: translate(710px, 649px); }
    .relationshipLine[data-id$="_9"] { d: path("M 158 778 L 158 815"); }
