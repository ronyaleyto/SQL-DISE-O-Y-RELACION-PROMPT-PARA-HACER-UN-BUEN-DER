---
config:
  theme: base
  look: neo
  layout: dagre
  fontFamily: "Segoe UI, Arial, sans-serif"
  themeVariables:
    darkMode: true
    primaryTextColor: "#e2e8f0"
    lineColor: "#a8bad7"
  er:
    fontSize: 12
    entityPadding: 8
    nodeSpacing: 38
    rankSpacing: 55
  themeCSS: |
    .violeta { --neon: #b692ff; --vidrio: #282240; }
    .cian { --neon: #52dcff; --vidrio: #173049; }
    .rosa { --neon: #ff78c8; --vidrio: #39263e; }
    .menta { --neon: #51f5b1; --vidrio: #19363b; }
    .node .outer-path { filter: drop-shadow(0 0 3px var(--neon)) drop-shadow(0 0 7px var(--neon)); }
    .node .outer-path path[stroke="none"] { fill: var(--vidrio) !important; }
    .node .outer-path path[fill="none"] { stroke: var(--neon) !important; stroke-width: 2px; }
    .node .row-rect-odd path[stroke="none"] { fill: var(--vidrio) !important; fill-opacity: .9; }
    .node .row-rect-even path[stroke="none"] { fill: #13203b !important; fill-opacity: .9; }
    .node .row-rect-odd path[fill="none"],
    .node .row-rect-even path[fill="none"] { stroke: #ffffff26 !important; }
    .node .divider { opacity: .25; }
    .node .name .nodeLabel p,
    .node .attribute-keys .nodeLabel p { color: var(--neon) !important; font-weight: 700; }
    .node .name foreignObject { overflow: visible; }
    .relationshipLine { stroke-width: 2px !important; }
    .edgeLabel .labelBkg { background-color: #152338 !important; color: #e2e8f0 !important; }
    .node .row-rect-odd path, .node .row-rect-even path { fill: none !important; stroke: none !important; }
    .relationshipLine { stroke-dasharray: 5 4 !important; stroke-linecap: round; }
    .relationshipLine.edge-pattern-solid { stroke-dasharray: none !important; }
    .node[id*="-entity-Campus-"] { transform: translate(168px, 120px); }
    .node[id*="-entity-Campus-"] .outer-path path { d: path("M -90 -96 H 90 Q 104 -96 104 -82 V 82 Q 104 96 90 96 H -90 Q -104 96 -104 82 V -82 Q -104 -96 -90 -96 Z"); }
    .node[id*="-entity-Edificios-"] { transform: translate(528px, 120px); }
    .node[id*="-entity-Edificios-"] .outer-path path { d: path("M -98 -96 H 98 Q 112 -96 112 -82 V 82 Q 112 96 98 96 H -98 Q -112 96 -112 82 V -82 Q -112 -96 -98 -96 Z"); }
    .node[id*="-entity-Aulas-"] { transform: translate(880px, 120px); }
    .node[id*="-entity-Aulas-"] .outer-path path { d: path("M -98 -96 H 98 Q 112 -96 112 -82 V 82 Q 112 96 98 96 H -98 Q -112 96 -112 82 V -82 Q -112 -96 -98 -96 Z"); }
    .node[id*="-entity-Carreras-"] { transform: translate(168px, 360px); }
    .node[id*="-entity-Carreras-"] .outer-path path { d: path("M -98 -96 H 98 Q 112 -96 112 -82 V 82 Q 112 96 98 96 H -98 Q -112 96 -112 82 V -82 Q -112 -96 -98 -96 Z"); }
    .node[id*="-entity-Planes-"] { transform: translate(528px, 360px); }
    .node[id*="-entity-Planes-"] .outer-path path { d: path("M -98 -96 H 98 Q 112 -96 112 -82 V 82 Q 112 96 98 96 H -98 Q -112 96 -112 82 V -82 Q -112 -96 -98 -96 Z"); }
    .node[id*="-entity-Cursos-"] { transform: translate(880px, 360px); }
    .node[id*="-entity-Cursos-"] .outer-path path { d: path("M -90 -96 H 90 Q 104 -96 104 -82 V 82 Q 104 96 90 96 H -90 Q -104 96 -104 82 V -82 Q -104 -96 -90 -96 Z"); }
    .node[id*="-entity-Estudiantes-"] { transform: translate(168px, 616px); }
    .node[id*="-entity-Estudiantes-"] .outer-path path { d: path("M -98 -96 H 98 Q 112 -96 112 -82 V 82 Q 112 96 98 96 H -98 Q -112 96 -112 82 V -82 Q -112 -96 -98 -96 Z"); }
    .node[id*="-entity-Matriculas-"] { transform: translate(528px, 616px); }
    .node[id*="-entity-Matriculas-"] .outer-path path { d: path("M -106 -112 H 106 Q 120 -112 120 -98 V 98 Q 120 112 106 112 H -106 Q -120 112 -120 98 V -98 Q -120 -112 -106 -112 Z"); }
    .node[id*="-entity-Secciones-"] { transform: translate(880px, 616px); }
    .node[id*="-entity-Secciones-"] .outer-path path { d: path("M -90 -96 H 90 Q 104 -96 104 -82 V 82 Q 104 96 90 96 H -90 Q -104 96 -104 82 V -82 Q -104 -96 -90 -96 Z"); }
    .node[id*="-entity-Becas-"] { transform: translate(168px, 872px); }
    .node[id*="-entity-Becas-"] .outer-path path { d: path("M -130 -96 H 130 Q 144 -96 144 -82 V 82 Q 144 96 130 96 H -130 Q -144 96 -144 82 V -82 Q -144 -96 -130 -96 Z"); }
    .node[id*="-entity-Pagos-"] { transform: translate(528px, 872px); }
    .node[id*="-entity-Pagos-"] .outer-path path { d: path("M -114 -96 H 114 Q 128 -96 128 -82 V 82 Q 128 96 114 96 H -114 Q -128 96 -128 82 V -82 Q -128 -96 -114 -96 Z"); }
    .node[id*="-entity-Evaluaciones-"] { transform: translate(880px, 872px); }
    .node[id*="-entity-Evaluaciones-"] .outer-path path { d: path("M -114 -96 H 114 Q 128 -96 128 -82 V 82 Q 128 96 114 96 H -114 Q -128 96 -128 82 V -82 Q -128 -96 -114 -96 Z"); }
    .node[id*="-entity-Convocatorias-"] { transform: translate(168px, 1128px); }
    .node[id*="-entity-Convocatorias-"] .outer-path path { d: path("M -82 -96 H 82 Q 96 -96 96 -82 V 82 Q 96 96 82 96 H -82 Q -96 96 -96 82 V -82 Q -96 -96 -82 -96 Z"); }
    .node[id*="-entity-Recibos-"] { transform: translate(528px, 1128px); }
    .node[id*="-entity-Recibos-"] .outer-path path { d: path("M -106 -96 H 106 Q 120 -96 120 -82 V 82 Q 120 96 106 96 H -106 Q -120 96 -120 82 V -82 Q -120 -96 -106 -96 Z"); }
    .node[id*="-entity-Resultados-"] { transform: translate(880px, 1128px); }
    .node[id*="-entity-Resultados-"] .outer-path path { d: path("M -122 -112 H 122 Q 136 -112 136 -98 V 98 Q 136 112 122 112 H -122 Q -136 112 -136 98 V -98 Q -136 -112 -122 -112 Z"); }
    .relationshipLine[data-id^="id_entity-Campus-"][data-id*="_entity-Edificios-"][data-id$="_0"] { d: path("M 272 120 L 416 120"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Campus-"][data-id*="_entity-Edificios-"][data-id$="_0"]) { transform: translate(344px, 100px); }
    .relationshipLine[data-id^="id_entity-Edificios-"][data-id*="_entity-Aulas-"][data-id$="_1"] { d: path("M 640 120 L 768 120"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Edificios-"][data-id*="_entity-Aulas-"][data-id$="_1"]) { transform: translate(704px, 100px); }
    .relationshipLine[data-id^="id_entity-Campus-"][data-id*="_entity-Carreras-"][data-id$="_2"] { d: path("M 168 216 L 168 264"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Campus-"][data-id*="_entity-Carreras-"][data-id$="_2"]) { transform: translate(213.6px, 240px); }
    .relationshipLine[data-id^="id_entity-Carreras-"][data-id*="_entity-Planes-"][data-id$="_3"] { d: path("M 280 360 L 416 360"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Carreras-"][data-id*="_entity-Planes-"][data-id$="_3"]) { transform: translate(348px, 340px); }
    .relationshipLine[data-id^="id_entity-Planes-"][data-id*="_entity-Cursos-"][data-id$="_4"] { d: path("M 640 360 L 776 360"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Planes-"][data-id*="_entity-Cursos-"][data-id$="_4"]) { transform: translate(708px, 340px); }
    .relationshipLine[data-id^="id_entity-Carreras-"][data-id*="_entity-Estudiantes-"][data-id$="_5"] { d: path("M 168 456 L 168 520"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Carreras-"][data-id*="_entity-Estudiantes-"][data-id$="_5"]) { transform: translate(211px, 488px); }
    .relationshipLine[data-id^="id_entity-Estudiantes-"][data-id*="_entity-Matriculas-"][data-id$="_6"] { d: path("M 280 616 L 408 616"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Estudiantes-"][data-id*="_entity-Matriculas-"][data-id$="_6"]) { transform: translate(344px, 596px); }
    .relationshipLine[data-id^="id_entity-Cursos-"][data-id*="_entity-Secciones-"][data-id$="_7"] { d: path("M 880 456 L 880 520"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Cursos-"][data-id*="_entity-Secciones-"][data-id$="_7"]) { transform: translate(918.4px, 488px); }
    .relationshipLine[data-id^="id_entity-Secciones-"][data-id*="_entity-Matriculas-"][data-id$="_8"] { d: path("M 776 616 L 648 616"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Secciones-"][data-id*="_entity-Matriculas-"][data-id$="_8"]) { transform: translate(712px, 596px); }
    .relationshipLine[data-id^="id_entity-Estudiantes-"][data-id*="_entity-Becas-"][data-id$="_9"] { d: path("M 168 712 L 168 776"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Estudiantes-"][data-id*="_entity-Becas-"][data-id$="_9"]) { transform: translate(222.1px, 744px); }
    .relationshipLine[data-id^="id_entity-Matriculas-"][data-id*="_entity-Pagos-"][data-id$="_10"] { d: path("M 528 728 L 528 776"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Matriculas-"][data-id*="_entity-Pagos-"][data-id$="_10"]) { transform: translate(578.3px, 752px); }
    .relationshipLine[data-id^="id_entity-Secciones-"][data-id*="_entity-Evaluaciones-"][data-id$="_11"] { d: path("M 880 712 L 880 776"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Secciones-"][data-id*="_entity-Evaluaciones-"][data-id$="_11"]) { transform: translate(924.6px, 744px); }
    .relationshipLine[data-id^="id_entity-Convocatorias-"][data-id*="_entity-Becas-"][data-id$="_12"] { d: path("M 168 1032 L 168 968"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Convocatorias-"][data-id*="_entity-Becas-"][data-id$="_12"]) { transform: translate(229.4px, 1000px); }
    .relationshipLine[data-id^="id_entity-Pagos-"][data-id*="_entity-Recibos-"][data-id$="_13"] { d: path("M 528 968 L 528 1032"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Pagos-"][data-id*="_entity-Recibos-"][data-id$="_13"]) { transform: translate(565.6px, 1000px); }
    .relationshipLine[data-id^="id_entity-Evaluaciones-"][data-id*="_entity-Resultados-"][data-id$="_14"] { d: path("M 880 968 L 880 1016"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Evaluaciones-"][data-id*="_entity-Resultados-"][data-id$="_14"]) { transform: translate(934.5px, 992px); }
    .relationshipLine[data-id^="id_entity-Matriculas-"][data-id*="_entity-Resultados-"][data-id$="_15"] { d: path("M 648 650 L 700 650 L 700 1128 L 744 1128"); }
    g.edgeLabel:has(.label[data-id^="id_entity-Matriculas-"][data-id*="_entity-Resultados-"][data-id$="_15"]) { transform: translate(700px, 992px); }
---
erDiagram
    direction TB

    Campus {
        int id PK
        text codigo
        text nombre
        text ciudad
    }
    Edificios {
        int id PK
        int campus_id FK
        text nombre
        int pisos
    }
    Aulas {
        int id PK
        int edificio_id FK
        text codigo
        int aforo
    }
    Carreras {
        int id PK
        int campus_id FK
        text nombre
        bool activa
    }
    Planes {
        int id PK
        int carrera_id FK
        text version
        date desde
    }
    Cursos {
        int id PK
        int plan_id FK
        text nombre
        int creditos
    }
    Estudiantes {
        int id PK
        int carrera_id FK
        text nombre
        date ingreso
    }
    Matriculas {
        int id PK
        int estudiante_id FK
        int seccion_id FK
        date fecha
        text estado
    }
    Secciones {
        int id PK
        int curso_id FK
        text turno
        int cupo
    }
    Becas {
        int id PK
        int estudiante_id FK
        int convocatoria_id FK
        numeric descuento
    }
    Pagos {
        int id PK
        int matricula_id FK
        numeric monto
        date fecha
    }
    Evaluaciones {
        int id PK
        int seccion_id FK
        text titulo
        numeric peso
    }
    Convocatorias {
        int id PK
        text titulo
        date abre
        date cierra
    }
    Recibos {
        int id PK
        int pago_id FK, UK
        text numero
        date emitido
    }
    Resultados {
        int id PK
        int evaluacion_id FK
        int matricula_id FK
        numeric nota
        bool publicado
    }

    Campus ||..o{ Edificios : campus_id
    Edificios ||..o{ Aulas : edificio_id
    Campus ||..o{ Carreras : campus_id
    Carreras ||..o{ Planes : carrera_id
    Planes ||..o{ Cursos : plan_id
    Carreras ||..o{ Estudiantes : carrera_id
    Estudiantes ||..o{ Matriculas : estudiante_id
    Cursos ||..o{ Secciones : curso_id
    Secciones ||..o{ Matriculas : seccion_id
    Estudiantes ||..o{ Becas : estudiante_id
    Matriculas ||..o{ Pagos : matricula_id
    Secciones ||..o{ Evaluaciones : seccion_id
    Convocatorias ||..o{ Becas : convocatoria_id
    Pagos ||..o| Recibos : pago_id
    Evaluaciones ||..o{ Resultados : evaluacion_id
    Matriculas ||..o{ Resultados : matricula_id

    class Campus,Planes,Secciones,Convocatorias violeta
    class Edificios,Cursos,Becas,Recibos cian
    class Carreras,Matriculas,Evaluaciones rosa
    class Aulas,Estudiantes,Pagos,Resultados menta
