    g.edgeLabel:has(.label[data-id$="_13"]) { transform: translate(577px, 1061.5px); }
    .relationshipLine[data-id$="_14"] { d: path("M 894 1043 L 894 1080"); }
    g.edgeLabel:has(.label[data-id$="_14"]) { transform: translate(945px, 1061.5px); }
    .relationshipLine[data-id$="_15"] { d: path("M 664 699 H 701 Q 710 699 710 708 V 1185 Q 710 1194 719 1194 H 756"); }
    g.edgeLabel:has(.label[data-id$="_15"]) { transform: translate(710px, 1107px); }
---
erDiagram
    direction TB

    Campus {
        int id PK
        text codigo
        text nombre
        text ciudad
    }
    Edificios {
        int id PK
        int campus_id FK
        text nombre
        int pisos
    }
    Aulas {
        int id PK
        int edificio_id FK
        text codigo
        int aforo
    }
    Carreras {
        int id PK
        int campus_id FK
        text nombre
        bool activa
    }
    Planes {
        int id PK
        int carrera_id FK
        text version
        date desde
    }
    Cursos {
        int id PK
        int plan_id FK
        text nombre
        int creditos
    }
    Estudiantes {
        int id PK
        int carrera_id FK
        text nombre
        date ingreso
    }
    Matriculas {
        int id PK
        int estudiante_id FK
        int seccion_id FK
        date fecha
        text estado
    }
    Secciones {
        int id PK
        int curso_id FK
        text turno
        int cupo
    }
    Becas {
        int id PK
        int estudiante_id FK
        int convocatoria_id FK
        numeric descuento
    }
    Pagos {
        int id PK
        int matricula_id FK
        numeric monto
        date fecha
    }
    Evaluaciones {
        int id PK
        int seccion_id FK
        text titulo
        numeric peso
    }
    Convocatorias {
        int id PK
        text titulo
        date abre
        date cierra
    }
    Recibos {
        int id PK
        int pago_id FK, UK
        text numero
        date emitido
    }
    Resultados {
        int id PK
        int evaluacion_id FK
        int matricula_id FK
        numeric nota
        bool publicado
    }

    Campus ||..o{ Edificios : campus_id
    Edificios ||..o{ Aulas : edificio_id
    Campus ||..o{ Carreras : campus_id
    Carreras ||..o{ Planes : carrera_id
    Planes ||..o{ Cursos : plan_id
    Carreras ||..o{ Estudiantes : carrera_id
    Estudiantes ||..o{ Matriculas : estudiante_id
    Cursos ||..o{ Secciones : curso_id
    Secciones ||..o{ Matriculas : seccion_id
    Estudiantes ||..o{ Becas : estudiante_id
    Matriculas ||..o{ Pagos : matricula_id
    Secciones ||..o{ Evaluaciones : seccion_id
    Convocatorias ||..o{ Becas : convocatoria_id
    Pagos ||..o| Recibos : pago_id
    Evaluaciones ||..o{ Resultados : evaluacion_id
    Matriculas ||..o{ Resultados : matricula_id

    class Campus,Planes,Secciones,Convocatorias violeta
    class Edificios,Cursos,Becas,Recibos cian
    class Carreras,Matriculas,Evaluaciones rosa
    class Aulas,Estudiantes,Pagos,Resultados menta
